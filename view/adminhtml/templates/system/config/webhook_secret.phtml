<?php /* @var $block \Radarsofthouse\Reepay\Block\System\Config\WebhookSecret */ ?>
<script>
    require(['jquery'], function(jQuery) {
        var webhookSecretSpan = jQuery('#webhook_secret_span');
        var webhookSecretButton = jQuery('#webhook_secret_button');
        var webhookSecretMessage = webhookSecretSpan.find('.webhook_secret_message_span');

        webhookSecretButton.click(function() {
            jQuery.ajax({
                url: '<?= $escaper->escapeUrl($block->getAjaxUrl()) ?>',
                type: 'POST',
                dataType: 'json',
                data: {
                    form_key: jQuery('input[name="form_key"]').first().val()
                },
                beforeSend: function() {
                    webhookSecretButton.prop('disabled', true);
                    webhookSecretSpan.find('.processing').show();
                    webhookSecretSpan.find('.updated').hide();
                    webhookSecretMessage.text('').css('color', '#e22626');
                },
                complete: function() {
                    webhookSecretButton.prop('disabled', false);
                    webhookSecretSpan.find('.processing').hide();
                },
                success: function(data, textStatus, jqXHR) {
                    var jsonResponse = jqXHR.responseJSON || data || {};
                    var resultText = jsonResponse.message || 'Webhook secret synchronization failed.';

                    if (jsonResponse.success === true) {
                        webhookSecretSpan.find('.updated').show();
                    }
                    if (jsonResponse.synced && jsonResponse.synced.length > 0) {
                        resultText += ' Synced: ' + jsonResponse.synced.length + '.';
                    }
                    if (jsonResponse.removed && jsonResponse.removed.length > 0) {
                        resultText += ' Removed: ' + jsonResponse.removed.length + '.';
                    }
                    if (jsonResponse.failed && jsonResponse.failed.length > 0) {
                        resultText += ' Failed: ' + jsonResponse.failed.length + '.';
                    }
                    if (jsonResponse.skipped && jsonResponse.skipped.length > 0) {
                        resultText += ' Skipped: ' + jsonResponse.skipped.length + '.';
                    }
                    webhookSecretMessage.text(resultText).css(
                        'color',
                        jsonResponse.success === true ? '#32CD32' : '#e22626'
                    );
                },
                error: function(response) {
                    webhookSecretMessage
                        .text(response.statusText || 'Webhook secret synchronization failed.')
                        .css('color', '#e22626');
                }
            });
        });
    });
</script>

<?= $block->getButtonHtml() ?>
<span class="collect-indicator" id="webhook_secret_span">
    <img class="processing" hidden="hidden" alt="Processing" style="margin:0 5px"
        src="<?= $escaper->escapeUrl($block->getViewFileUrl('images/process_spinner.gif')) ?>" />
    <img class="updated" hidden="hidden" alt="Updated" style="margin:-3px 5px"
        src="<?= $escaper->escapeUrl($block->getViewFileUrl('images/rule_component_apply.gif')) ?>" />
    <span class="webhook_secret_message_span" style="color: red; font-size: 12px;"></span>
</span>
<p class="note"><span>Save Test and Live Private API Keys before syncing.</span></p>
